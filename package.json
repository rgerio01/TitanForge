{
  "name": "titanforge-launcher",
  "version": "2.5.26",
  "description": "TitanForge Launcher - Sistema de gerenciamento de jogos Steam",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:preload\" \"npm run dev:renderer\" \"npm run start:wait\"",
    "dev:main": "webpack --config webpack.main.config.js --mode development --watch",
    "dev:preload": "webpack --config webpack.preload.config.js --mode development --watch",
    "dev:renderer": "webpack serve --config webpack.renderer.config.js --mode development",
    "start:wait": "wait-on http://localhost:3000 && electron .",
    "clean": "rimraf dist release",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "build:main": "cross-env NODE_ENV=production webpack --config webpack.main.config.js --mode production",
    "build:preload": "cross-env NODE_ENV=production webpack --config webpack.preload.config.js --mode production",
    "build:renderer": "cross-env NODE_ENV=production webpack --config webpack.renderer.config.js --mode production",
    "build:production": "npm run clean && npm run build && npm run package",
    "start": "electron .",
    "package": "electron-builder",
    "package:win": "electron-builder --win --x64"
  },
  "author": "TitanForge Team",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "adm-zip": "^0.5.10",
    "assert": "^2.1.0",
    "axios": "^1.6.0",
    "browserify-zlib": "^0.2.0",
    "buffer": "^6.0.3",
    "constants-browserify": "^1.0.0",
    "crypto-browserify": "^3.12.1",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.6.2",
    "events": "^3.3.0",
    "framer-motion": "^10.16.0",
    "https-browserify": "^1.0.0",
    "lucide-react": "^0.554.0",
    "node-machine-id": "^1.1.12",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "public-ip": "^6.0.1",
    "querystring-es3": "^0.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "regedit": "^5.1.2",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.2.0",
    "url": "^0.11.4",
    "util": "^0.12.5",
    "vm-browserify": "^1.1.2"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "copy-webpack-plugin": "^13.0.1",
    "cross-env": "^10.1.0",
    "css-loader": "^6.8.1",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electron-icon-builder": "^2.0.1",
    "html-webpack-plugin": "^5.6.0",
    "postcss": "^8.4.32",
    "postcss-loader": "^7.3.3",
    "rimraf": "^6.1.2",
    "sharp": "^0.34.5",
    "style-loader": "^3.3.3",
    "tailwindcss": "^3.4.0",
    "to-ico": "^1.1.5",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.0",
    "wait-on": "^7.2.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  },
  "build": {
    "appId": "com.titanforge.launcher",
    "productName": "TitanForge Launcher",
    "asar": true,
    "asarUnpack": [
      "assets/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      { "from": ".env.efi", "to": ".env.efi" },
      { "from": "certificado.p12", "to": "certificado.p12" }
    ],
    "extraMetadata": {
      "main": "dist/main/index.js"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icons/icon.ico",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "rgerio01",
      "repo": "TitanForge",
      "private": true,
      "releaseType": "release"
    }
  }
}
